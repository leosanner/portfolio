---
import Base from '../../layouts/Base.astro';
import Experience from '../../components/Experience';
import { locales, t, ui, type Locale } from '../../i18n/ui';
import { profile, education } from '../../data/profile';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const tr = t(lang);
---

<Base lang={lang}>
  <section class="hero">
    <div class="hero__inner">
      <h1 class="hero__name">Leonardo<br />Sanner</h1>
      <p class="hero__headline">
        {profile.headline[lang]}, <em>{profile.location[lang]}</em>
      </p>
      <p class="hero__bio">{profile.bio[lang]}</p>
      <ul class="pills">
        <li><a href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href={profile.links.github} target="_blank" rel="noopener">GitHub</a></li>
      </ul>
    </div>
  </section>

  <section id="experience" class="section">
    <div class="section__head">
      <h2>{tr('experience.title')}</h2>
      <p>{tr('experience.intro')}</p>
    </div>
    <Experience client:visible lang={lang} ui={ui[lang]} />
  </section>

  <section id="education" class="section">
    <div class="section__head">
      <h2>{tr('education.title')}</h2>
    </div>
    <table class="edu">
      <tbody>
        {
          education.map((e) => (
            <tr>
              <th scope="row">
                {e.degree[lang]}
                <span>{e.institution}</span>
              </th>
              <td class="edu__period">{e.period[lang]}</td>
              <td>{e.note?.[lang]}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section id="contact" class="section">
    <div class="section__head">
      <h2>{tr('contact.title')}</h2>
      <p>{tr('contact.body')}</p>
    </div>
    <ul class="contact">
      <li>
        <a href={profile.links.linkedin} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11H3v-11Zm6.5 0h3.8v1.5h.06c.53-1 1.83-1.8 3.76-1.8 4.02 0 4.88 2.4 4.88 5.6v5.7h-4v-5c0-1.2-.02-2.8-1.7-2.8-1.7 0-1.96 1.33-1.96 2.7v5.1h-4v-11Z"/></svg>
          {tr('contact.linkedin')}
        </a>
      </li>
      <li>
        <a href={profile.links.github} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.3 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>
          {tr('contact.github')}
        </a>
      </li>
    </ul>
  </section>
</Base>
